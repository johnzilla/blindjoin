# Required environment variables for the blindjoin Docker Compose stack.
# Copy to .env and fill in values before running docker compose up.

# ---------------------------------------------------------------------------
# Legacy v1.3 liquidity bot env vars (still honoured by v1.4 as a fallthrough).
# When BOT_SCRIPT_TYPES is unset (default "p2wpkh") and BOT_P2WPKH_UTXO is
# unset, the bot reads BLINDJOIN_UTXO + BLINDJOIN_UTXO_WIF from these vars.
# New operators should use the BOT_P2WPKH_* vars below instead.
# ---------------------------------------------------------------------------
# Liquidity bot UTXO configuration (signet UTXOs only — bot refuses mainnet)
# Get a signet UTXO from: https://signet.bc-2.jp/ or mine your own blocks
BOT_UTXO=txid:vout
BOT_UTXO_VALUE_SATS=200000000
BOT_WIF=cXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ---------------------------------------------------------------------------
# Phase 18 liquidity bot multi-script + per-round rotation (INTEG-02)
# ---------------------------------------------------------------------------

# CSV of script types the bot rotates across (default: p2wpkh = v1.3 compat).
# Accepted tokens: p2wpkh, p2tr, p2sh-p2wpkh (lowercase kebab-case).
# Example for full rotation: BOT_SCRIPT_TYPES=p2wpkh,p2tr,p2sh-p2wpkh
BOT_SCRIPT_TYPES=p2wpkh

# Per-type tuples (only required when the matching type is enabled in BOT_SCRIPT_TYPES).

# P2WPKH (from_wif path — single-key wallet):
BOT_P2WPKH_UTXO=
BOT_P2WPKH_WIF=

# P2TR (descriptor path — BIP-86 xprv descriptor + address required):
# Descriptor shape: tr(xprv.../86'/0'/0'/0/*)
# Run: blindjoin client --generate-wallet --type p2tr to generate
BOT_P2TR_UTXO=
BOT_P2TR_DESCRIPTOR=
BOT_P2TR_UTXO_ADDRESS=

# P2SH-P2WPKH (descriptor path — BIP-49 xprv descriptor + address required):
# Descriptor shape: sh(wpkh(xprv.../49'/0'/0'/0/*))
# Run: blindjoin client --generate-wallet --type p2sh-p2wpkh to generate
BOT_P2SH_P2WPKH_UTXO=
BOT_P2SH_P2WPKH_DESCRIPTOR=
BOT_P2SH_P2WPKH_UTXO_ADDRESS=
