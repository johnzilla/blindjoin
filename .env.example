# Required environment variables for the blindjoin Docker Compose stack.
# Copy to .env and fill in values before running docker compose up.

# Liquidity bot UTXO configuration (signet UTXOs only — bot refuses mainnet)
# Get a signet UTXO from: https://signet.bc-2.jp/ or mine your own blocks
BOT_UTXO=txid:vout
BOT_UTXO_VALUE_SATS=200000000
BOT_WIF=cXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
